    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "__AZURE_MONITOR_DATASOURCE_UID__"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "CUSTOMER_IMPACT": {
                  "color": "red",
                  "index": 0,
                  "text": "CUSTOMER IMPACT"
                },
                "DEGRADED": {
                  "color": "yellow",
                  "index": 1,
                  "text": "DEGRADED"
                },
                "HEALTHY": {
                  "color": "green",
                  "index": 2,
                  "text": "HEALTHY (demo)"
                },
                "NO_DATA": {
                  "color": "orange",
                  "index": 3,
                  "text": "NO DATA — UNKNOWN"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "NO DATA — UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 0,
        "y": 41
      },
      "id": 10,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^State$/",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "azureMonitor": {
            "queryType": "Logs",
            "query": "AppRequests\n| where TimeGenerated > ago(10m)\n| where Name == 'slo.meter-ingest.transaction'\n| extend SyntheticName = tostring(Properties['synthetic.name']), SyntheticMode = tostring(Properties['synthetic.mode']), CorrelationId = tostring(Properties['synthetic.correlation_id']), FailureStage = tostring(Properties['synthetic.failure_stage']), FailureReason = tostring(Properties['synthetic.failure_reason'])\n| where SyntheticName == 'slo-meter-ingest' and SyntheticMode == 'demo'\n| where isnotempty(CorrelationId)\n| summarize arg_max(TimeGenerated, Success, DurationMs, FailureStage, FailureReason) by CorrelationId\n| summarize RunCount = count(), SuccessfulRunCount = countif(Success == true), LastSuccessfulTransaction = maxif(TimeGenerated, Success == true), LatestCriticalFailure = maxif(TimeGenerated, Success == false and FailureStage in ('persistence', 'ingress'))\n| extend SuccessRatePct = iff(RunCount > 0, 100.0 * todouble(SuccessfulRunCount) / todouble(RunCount), real(null))\n| extend FreshnessMinutes = iff(isnull(LastSuccessfulTransaction), real(null), todouble(datetime_diff('second', now(), LastSuccessfulTransaction)) / 60.0)\n| extend State = case(RunCount == 0, 'NO_DATA', not(isnull(LatestCriticalFailure)) and (isnull(LastSuccessfulTransaction) or LastSuccessfulTransaction <= LatestCriticalFailure), 'CUSTOMER_IMPACT', SuccessfulRunCount == 0, 'CUSTOMER_IMPACT', FreshnessMinutes > 5.0 or SuccessRatePct < 95.0, 'DEGRADED', 'HEALTHY')\n| project State",
            "workspaceResourceId": "__WORKSPACE_RESOURCE_ID__",
            "resourceGroup": "__RESOURCE_GROUP__",
            "subscriptionId": "__SUBSCRIPTION_ID__"
          }
        }
      ],
      "title": "Synthetic customer-impact state",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
