            "query": "AppRequests\n| where TimeGenerated between (ago(2h) .. now())\n| extend namespace = tostring(customDimensions['sre.namespace']), service = tostring(customDimensions['sre.service']), scenario = tostring(customDimensions['sre.scenario']), resultCode = tostring(ResultCode)\n| where namespace =~ '$namespace'\n| where ('$service' == '.*' or service =~ '$service')\n| where ('$scenario' == 'all' or scenario =~ '$scenario')\n| summarize Errors = countif(todouble(resultCode) >= 500) by bin(TimeGenerated, 15m)\n| order by TimeGenerated asc",
            "workspaceResourceId": "__WORKSPACE_RESOURCE_ID__",
            "resourceGroup": "__RESOURCE_GROUP__",
