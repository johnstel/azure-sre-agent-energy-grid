      "targets": [
        {
          "refId": "A",
          "azureMonitor": {
            "queryType": "Logs",
            "query": "AppRequests\n| where TimeGenerated > ago(10m)\n| where Name == 'slo.meter-ingest.transaction'\n| extend SyntheticName = tostring(Properties['synthetic.name']), SyntheticMode = tostring(Properties['synthetic.mode']), CorrelationId = tostring(Properties['synthetic.correlation_id']), FailureStage = tostring(Properties['synthetic.failure_stage'])\n| where SyntheticName == 'slo-meter-ingest' and SyntheticMode == 'demo'\n| where isnotempty(CorrelationId)\n| summarize arg_max(TimeGenerated, Success, DurationMs, FailureStage) by CorrelationId\n| summarize RunCount = count(), SuccessfulRunCount = countif(Success == true)\n| extend SuccessRatePct = iff(RunCount > 0, 100.0 * todouble(SuccessfulRunCount) / todouble(RunCount), real(null))\n| project SuccessRatePct",
            "workspaceResourceId": "__WORKSPACE_RESOURCE_ID__",
            "resourceGroup": "__RESOURCE_GROUP__",
            "subscriptionId": "__SUBSCRIPTION_ID__"
          }
        }
      ],
      "title": "Success rate (10m, target ≥95%)",
