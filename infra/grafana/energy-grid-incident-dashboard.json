        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "### Incident handoff\n- Environment (context): **$environment**\n- Namespace: **$namespace**\n- Service: **$service**\n- Scenario (context): **$scenario**\n- This dashboard surfaces Kubernetes and application telemetry for operator review.\n- Requests/errors and dependency-failure panels use Azure Monitor / Log Analytics data when available; otherwise they show an empty state instead of a healthy-looking zero.\n- Use the links above for the runbook, safe-language guardrails, and the portal handoff.",
        "mode": "markdown"
      },
      "pluginVersion": "10.4.3",
      "title": "Incident handoff and safe links",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": false
          },
          "mappings": [],
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (phase) (kube_pod_status_phase{namespace=~\"$namespace\", pod=~\"^($service)(-|$)\"})",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ],
      "title": "Namespace health (Running / Pending / Failed)",
      "type": "timeseries"
    },
