      "targets": [
        {
          "refId": "A",
          "azureMonitor": {
            "queryType": "Logs",
            "query": "AppRequests\n| where TimeGenerated between (ago(30m) .. now())\n| extend namespace = tostring(customDimensions['sre.namespace']), service = tostring(customDimensions['sre.service']), scenario = tostring(customDimensions['sre.scenario']), resultCode = tostring(ResultCode)\n| where namespace =~ '$namespace'\n| where ('$service' == '.*' or service startswith '$service')\n| where ('$scenario' == 'all' or scenario =~ '$scenario')\n| summarize Requests = count(), Errors = countif(todouble(resultCode) >= 500) by service\n| order by Errors desc, Requests desc",
            "workspaceResourceId": "__WORKSPACE_RESOURCE_ID__",
            "resourceGroup": "__RESOURCE_GROUP__",
            "subscriptionId": "__SUBSCRIPTION_ID__"
          }
        }
      ],
      "title": "Requests and errors",
      "type": "table"
    },
