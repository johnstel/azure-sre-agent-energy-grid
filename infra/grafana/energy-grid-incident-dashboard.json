          "refId": "A",
          "azureMonitor": {
            "queryType": "Logs",
            "query": "AppDependencies\n| where TimeGenerated between (ago(30m) .. now())\n| extend namespace = tostring(customDimensions['sre.namespace']), service = tostring(customDimensions['sre.service']), scenario = tostring(customDimensions['sre.scenario']), dependencyType = tostring(DependencyType), success = tostring(Success)\n| where namespace =~ '$namespace'\n| where ('$service' == '.*' or service =~ '$service')\n| where ('$scenario' == 'all' or scenario =~ '$scenario')\n| where success =~ 'False'\n| summarize Failures = count() by dependencyType, service\n| order by Failures desc",
            "workspaceResourceId": "__WORKSPACE_RESOURCE_ID__",
            "resourceGroup": "__RESOURCE_GROUP__",
            "subscriptionId": "__SUBSCRIPTION_ID__"
          }
        }
      ],
      "title": "Dependency failures",
      "type": "table"
